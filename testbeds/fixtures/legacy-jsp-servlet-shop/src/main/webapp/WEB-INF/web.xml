<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee https://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <display-name>legacy-jsp-servlet-shop</display-name>

    <servlet>
        <servlet-name>shopOrderServlet</servlet-name>
        <servlet-class>com.acme.legacy.shop.web.ShopOrderServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>shopOrderServlet</servlet-name>
        <url-pattern>/shop/orders/search</url-pattern>
    </servlet-mapping>
</web-app>
